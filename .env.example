# Скопируйте в .env и заполните. .env в git не коммитим.
# Значения «change-me…» годятся только для локального стенда на фейках (make up);
# make deploy (стенд с HTTPS) не запустится с ними — проверяет deploy/stand-check.sh.

# --- общие ---
# PostgreSQL: с этими учётными данными контейнер postgres создаёт базу (deploy/docker-compose.yml)
POSTGRES_USER=inote
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=inote
# Строка подключения к PostgreSQL (D): драйвер asyncpg бэкенд подставляет сам,
# поэтому подходит и обычная схема postgresql://. Пароль — тот же, что в POSTGRES_PASSWORD
DATABASE_URL=postgresql://inote:change-me-dev-only@postgres:5432/inote
REDIS_URL=redis://redis:6379/0
# Токен внутренних вызовов: Authorization: Bearer <SERVICE_TOKEN> (mcp, /internal/*, scheduler → бот)
SERVICE_TOKEN=change-me-dev-only
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
# Часовой пояс нового пользователя (IANA), пока он не выбрал свой
DEFAULT_TZ=Europe/Moscow

# --- зона C ---
# бот: fake — MAX в памяти и /dev/max/*; real — пока падает (адаптер MAX не выбран)
BOT_MAX_MODE=fake
# токен бота MAX (business.max.ru) — нужен для BOT_MAX_MODE=real; на стенде им же api проверяет
# подпись initData (docker-compose.stand.yml подставляет его в API_MAX_BOT_TOKEN)
BOT_MAX_TOKEN=
BOT_MAX_API_URL=https://platform-api2.max.ru
# сертификат НУЦ Минцифры для API MAX; на стенде — файл из deploy/certs (см. deploy/certs/README.md)
BOT_MAX_CA_BUNDLE=
# таймаут запроса к MAX API, с (long polling — по BOT_POLL_TIMEOUT_S)
BOT_MAX_TIMEOUT_S=10
BOT_POLL_TIMEOUT_S=30
BOT_RATE_LIMIT_PER_MIN=20
BOT_SHUTDOWN_TIMEOUT_S=10
# задержка «отправки» в фейковом MAX, мс (lifecycle-тесты)
BOT_FAKE_SEND_DELAY_MS=0
# порт бота на 127.0.0.1 для /dev/max/* (make up, smoke)
BOT_DEV_PORT=8001
# бот → агент (API из contracts/reply.py): стандарт — 45 с без повторов
BOT_AGENT_URL=http://agent:8000
BOT_AGENT_TIMEOUT_S=45
# кнопка мини-приложения: open_app (payload = start_param) или link (https://max.ru/<бот>?startapp=…)
BOT_OPEN_APP_MODE=open_app
# имя бота в MAX — web_app у open_app и адрес deep link; выдают после модерации
BOT_USERNAME=
# как часто повторять «печатает…», секунды
BOT_TYPING_INTERVAL_S=4
# бот → ASR (J1): 15 с и до 2 повторов; голосовое больше лимита — «слишком длинное»
BOT_ASR_URL=http://asr:8000
BOT_ASR_TIMEOUT_S=15
BOT_VOICE_MAX_BYTES=1048576
BOT_VOICE_DOWNLOAD_TIMEOUT_S=10
# фейковый MAX: откуда бот скачивает голосовые /dev/max/files (сам у себя)
BOT_FAKE_FILES_URL=http://127.0.0.1:8000
# апдейты MAX: polling (GET /updates, разработка) | webhook (POST /webhook/max за Caddy, стенд)
BOT_UPDATES_MODE=polling
# webhook: адрес подписки (у MAX — только https:// на 443) и секрет X-Max-Bot-Api-Secret
# (5–256 символов a-zA-Z0-9_-, например: openssl rand -hex 24); оба обязательны в режиме webhook
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
# сколько апдейтов обрабатывать одновременно (у одного пользователя — всегда по очереди)
BOT_MAX_CONCURRENT_UPDATES=16
# стенд с HTTPS (deploy/docker-compose.stand.yml): домен для сертификата и почта Let's Encrypt
STAND_DOMAIN=
ACME_EMAIL=
# агент: scripted — правила вместо LLM (mock); llm — Brain участника B (full, переменные LLM_*)
AGENT_BRAIN=scripted
# агент: бюджет хода (вместе с ожиданием лока) и ожидание лока пользователя, секунды
AGENT_TURN_TIMEOUT_S=40
AGENT_LOCK_WAIT_S=10
# агент: ходов с LLM на пользователя в сутки (только AGENT_BRAIN=llm) — защита бюджета GigaChat
AGENT_LLM_DAILY_LIMIT=200
# агент → MCP (J3): одна сессия Streamable HTTP; таймаут вызова, секунды (стандарт: 5 с, 1 повтор)
AGENT_MCP_URL=http://mcp:8000/mcp
# агент → служебный REST того же контейнера (J8 users/resolve) и его /health/live для readiness
AGENT_MCP_INTERNAL_URL=http://mcp:8000
AGENT_MCP_TIMEOUT_S=5
# J4 (S3): Scheduler (D) → бот POST /internal/v1/notify под SERVICE_TOKEN; вручную —
# contracts/examples/notify/notify.sh all. Новых переменных в S3 нет (голосового ответа нет).
# asr (J1, services/asr): провайдер на стенде задаёт Makefile по профилю — mock: fake, full: yandex;
# строка ниже — для запуска сервиса руками. Ключ — только сюда, в .env (в git не попадает).
ASR_PROVIDER=fake
# SpeechKit: API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user; folder id — только для
# ключа пользователя (с ключом сервисного аккаунта оставить пустым)
ASR_YANDEX_API_KEY=
ASR_YANDEX_FOLDER_ID=
ASR_YANDEX_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
# одна попытка к SpeechKit и повторы (на 5xx и сеть); весь бюджет — меньше таймаута бота (15 с)
ASR_PROVIDER_TIMEOUT_S=6
ASR_PROVIDER_RETRIES=1
ASR_DEADLINE_S=13
# лимиты синхронного SpeechKit: 1 МБ и 30 с; больше — audio_too_long без платного запроса
ASR_MAX_BYTES=1048576
ASR_MAX_DURATION_S=30
# уверенность ниже — low_confidence (SpeechKit v1 уверенность не сообщает — тогда всегда false)
ASR_LOW_CONFIDENCE_BELOW=0.6
# --- конец зоны C ---

# --- зона D ---
# api: токен бота MAX — им проверяется подпись initData мини-приложения
API_MAX_BOT_TOKEN=change-me-dev-only
# api: ключ подписи JWT, не короче 32 символов
API_JWT_SECRET=change-me-dev-only-jwt-secret-0123456789
# api: true — принимать initData без подписи. Только на машине разработчика, на стенде false
API_DEV_AUTH=false
# api: порт на 127.0.0.1 для `npm run dev` мини-приложения (make up); на стенде с HTTPS не публикуется
API_DEV_PORT=8000
# scheduler: адрес бота роли C, куда уходят напоминания (J4)
SCHED_BOT_URL=http://bot:8000
# scheduler: пауза между проходами цикла, секунды
SCHED_INTERVAL_SECONDS=15
# --- конец зоны D ---

# --- зона B ---
# Brain агента (включается AGENT_BRAIN=llm; make с PROFILE=full ставит gigachat): fake — без сети и денег;
# gigachat — GigaChat (платно, нужен ключ ниже)
LLM_PROVIDER=fake
LLM_MODEL=GigaChat-2-Max
# запасная модель, если основная недоступна; пусто — без запасной
LLM_FALLBACK_MODEL=GigaChat-2-Pro
# таймаут одного вызова модели, с (не больше 20: агент ждёт ход 40 с)
LLM_TIMEOUT_S=12
# сколько всего модель может думать за ход вместе с повторами, с (не больше 30)
LLM_TURN_BUDGET_S=25
# сколько раз за ход модель может вызвать инструменты
LLM_MAX_STEPS=4
# ключ авторизации GigaChat (Base64 из личного кабинета); пока не подключаем
LLM_GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица; GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# путь к сертификату НУЦ Минцифры (им подписан GigaChat); пусто — системные сертификаты
LLM_GIGACHAT_CA_BUNDLE=
LLM_GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
# --- конец зоны B ---
