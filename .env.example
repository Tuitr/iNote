# Учётные данные PostgreSQL для контейнера postgres в compose.yaml
POSTGRES_USER=inote
POSTGRES_PASSWORD=
POSTGRES_DB=inote

# Строка подключения к PostgreSQL. Драйвер asyncpg бэкенд подставляет сам,
# поэтому подходит и обычная схема postgresql://
DATABASE_URL=postgresql://inote:<POSTGRES_PASSWORD>@postgres:5432/inote
REDIS_URL=redis://redis:6379/0
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
