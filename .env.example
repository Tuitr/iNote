# Учётные данные PostgreSQL для контейнера postgres в compose.yaml
POSTGRES_USER=inote
POSTGRES_PASSWORD=
POSTGRES_DB=inote

# Строка подключения к PostgreSQL. Драйвер asyncpg бэкенд подставляет сам,
# поэтому подходит и обычная схема postgresql://
DATABASE_URL=postgresql://inote:<POSTGRES_PASSWORD>@postgres:5432/inote
REDIS_URL=redis://redis:6379/0
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Часовой пояс нового пользователя (IANA), пока он не выбрал свой
DEFAULT_TZ=Europe/Moscow
# Токен для вызовов mcp из других сервисов: Authorization: Bearer <SERVICE_TOKEN>
SERVICE_TOKEN=

# Только для тестов: отдельная база, тесты удаляют в ней все таблицы.
# Не задана — тесты с базой пропускаются.
TEST_DATABASE_URL=postgresql://inote:<пароль>@localhost:5432/inote_test
