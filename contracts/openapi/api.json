    "/v1/items": {
      "get": {
        "tags": [
          "items"
        ],
        "summary": "List Items",
        "description": "ETag равен версии данных пользователя: с If-None-Match той же версии ответ 304 без тела. Ответы кешируются на 5 минут под версией данных.",
        "operationId": "list_items_v1_items_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemKind"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "open",
                "done",
                "all"
              ],
              "type": "string",
              "default": "open",
              "title": "Status"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "day",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Group"
            }
          },
          {
            "name": "if-none-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ItemsByDayResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ItemsResponse"
                    }
                  ],
                  "title": "Response List Items V1 Items Get"
                },
                "examples": {
                  "group=day": {
                    "value": {
                      "range": {
                        "from": "2026-10-19",
                        "to": "2026-10-22",
                        "tz": "Europe/Moscow"
                      },
                      "version": 42,
                      "days": [
                        {
                          "date": "2026-10-19",
                          "label": "Пн, 19 октября",
